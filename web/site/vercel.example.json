{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-API-HOST/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/BACKEND.md",
      "destination": "/dashboard/#/backend",
      "permanent": false
    }
  ]
}